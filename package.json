{
  "name": "dsh-appshots",
  "version": "0.1.4",
  "description": "Codex-style window capture for DSH Desktop: press both Command/Ctrl keys (or the camera button) to grab the frontmost window on macOS or Windows, attach it to the current chat, and inject available window text as hidden context.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "native",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "WongYuYe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WongYuYe/dsh-appshots.git"
  },
  "bugs": {
    "url": "https://github.com/WongYuYe/dsh-appshots/issues"
  },
  "homepage": "https://github.com/WongYuYe/dsh-appshots#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "appshots",
    "screenshot",
    "macos",
    "windows"
  ],
  "os": [
    "darwin",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:native": "mkdir -p bin && swiftc -O native/AppshotCapture.swift -o bin/appshot-capture"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
